# Copy to brain/.env (gitignored). NEVER commit real values.
# Use freshly-rotated keys; never paste secrets into chat.

# --- LLM ---
# ChatKit/agent brain. Use a freshly-rotated OpenAI key.
OPENAI_API_KEY=sk-...

# --- L1 RPC ---
# Mainnet RPC for ENS reads/writes + provisioning. A paid endpoint (Alchemy)
# is strongly recommended; free RPCs rate-limit under load.
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<your-key>

# --- Operator signing (provisioning) ---
# Hot key that co-signs provisioning steps. SECRET — 0x-prefixed private key.
OPERATOR_HOT_KEY=0x<operator-hot-key-private-key>
# Bearer token guarding operator-only brain endpoints (/provision, approve).
# If unset, auth is DISABLED (local dev only). Set in any deployed brain.
OPERATOR_TOKEN=<random-long-token>

# --- TEE agent-wallet (mm CLI) bootstrap ---
# Base64 of session.json / wallets.json, used ONCE to bootstrap the mm CLI
# state onto the persistent volume when the files are missing. SECRET.
MM_SESSION_B64=
MM_WALLETS_B64=
# Force re-bootstrap from the B64 vars even if files exist (default off).
# MM_FORCE_BOOTSTRAP=
# Only needed for transfer_execute (BYOK signing unlock). Reads don't need it.
MM_PASSWORD=

# --- Worker (relying-party verifier + agent card) ---
# CF Worker exposing ENS tools + /evaluate. Local: bun run worker:dev (:8787).
WORKER_URL=http://127.0.0.1:8787
WORKER_API_KEY=local-dev-key
# Public base for the agent card/avatar endpoints.
CARD_WORKER_BASE=https://<your-worker>.workers.dev

# --- ENS names ---
# Parent name that owns the fleet / mints subnames.
STEG_PARENT=steg.eth
# Default agent name the gate/verifier reads.
STEG_DEMO_NAME=agent.steg.eth

# --- Provisioning tunables (optional; sane defaults in code) ---
# Per-step timeout (seconds) for the provisioning background job.
# PROVISION_STEP_TIMEOUT=150
# Rate limiting for /provision requests.
# PROVISION_RATE_MAX=
# PROVISION_RATE_WINDOW=
# ETH budget for the reverse-record gas top-up.
# REVERSE_GAS_ETH=
