# Copy to .env.local (gitignored). Vite inlines every VITE_* var into the
# CLIENT bundle at build time — treat all of these as PUBLIC. Never put a
# private key, operator token, or any real secret here.

# The agent name the cockpit reads/acts on (e.g. agent.steg.eth).
VITE_AGENT_NAME=agent.steg.eth

# L1 RPC used by the browser for fresh ENS resolution. A public/host-bound
# Alchemy or dRPC URL is fine; it ships in the bundle by design.
VITE_MAINNET_RPC=https://eth-mainnet.g.alchemy.com/v2/<public-or-host-bound-key>

# ChatKit backend URL. Unset => same-origin "/chatkit" (proxied to the brain
# in production via vercel.json rewrites). Set to the brain URL for local dev.
# VITE_CHATKIT_URL=http://127.0.0.1:8000/chatkit

# ChatKit domain key — HOST-BOUND public key, one per deploy origin
# (e.g. your-app.vercel.app). Low sensitivity, but set it per environment.
VITE_CHATKIT_DOMAIN_KEY=domain_pk_...

# WalletConnect project id (public). Optional; only for wallet-connect flows.
# VITE_WALLET_CONNECT_PROJECT_ID=...
