{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/chatkit",
      "destination": "https://steg-brain-production.up.railway.app/chatkit"
    },
    {
      "source": "/agent/:path*",
      "destination": "https://steg-brain-production.up.railway.app/agent/:path*"
    },
    {
      "source": "/provision",
      "destination": "https://steg-brain-production.up.railway.app/provision"
    },
    {
      "source": "/provision/:path*",
      "destination": "https://steg-brain-production.up.railway.app/provision/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://steg-agent-card.estmcmxci.workers.dev/:path*"
    }
  ]
}
