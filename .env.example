# L1 RPC for fresh ENS resolution. eth.drpc.org is the project default
# (llamarpc hangs). Override with a paid endpoint if rate-limited.
ETH_RPC_URL=https://eth.drpc.org

# Optional: pin the ENS Universal Resolver (read-side entrypoint). Unset =>
# viem's bundled default (currently this same canonical address). This is NOT
# the resolver agent.steg.eth points at. https://docs.ens.domains/resolvers/universal/
ENS_UNIVERSAL_RESOLVER=0xeEeEEEeE14D718C2B47D9923Deab1335E144EeEe

# The agent name whose ENS-published authorization state the verifier reads.
STEG_DEMO_NAME=agent.steg.eth

# The agent wallet that signs action requests — the MetaMask Agentic CLI (mm)
# BYOK wallet. This is the `signer` baked into the credential record.
AGENT_ADDRESS=0x2B4C7Ac514CE4f6FbEf26e23F83536C8E5838979

# The operator/parent name that holds the Tier-1 fleet envelope (optional).
STEG_FLEET_NAME=steg.eth
